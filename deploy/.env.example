# AegisNexus — .env Example (Victim Atlas module)
# Copy to .env and fill in your values
# cp .env.example .env

# ── Database (SQLite) ─────────────────────────────────
DATABASE_URL=sqlite:///./data/aegis.db

# ── Gemini API (Victim Atlas classification) ─────────
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-2.0-flash

# ── Celery Broker ─────────────────────────────────────
CELERY_BROKER_URL=amqp://guest:guest@localhost:5672//
CELERY_RESULT_BACKEND=rpc://
CELERY_TIMEZONE=UTC

# ── Celery Beat Intervals ──────────────────────────────
VICTIM_ATLAS_INGEST_INTERVAL=21600
VICTIM_ATLAS_SOURCE_ITEM_LIMIT=120
VICTIM_ATLAS_ENRICH_LIMIT=500

# ── PDF Output ─────────────────────────────────────────
PDF_OUTPUT_DIR=/var/www/aegisnexus/reports

# ── FastAPI ────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
APP_WORKERS=4

# ── Frontend ───────────────────────────────────────────
VITE_API_BASE=/api/v2
