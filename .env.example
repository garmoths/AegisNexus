# ── Uygulama ───────────────────────────────────────────────────
# Tüm ayarlar app/config.py içinde tiplenmiş ve varsayılanlıdır; hepsi opsiyoneldir.
# Veritabanı: SQLite (kişisel proje — Postgres kaldırıldı)
# ./run.sh ile yerel data/aegis.db olarak saklanır.
DATABASE_URL=sqlite:///./data/aegis.db

# ── Güvenlik ───────────────────────────────────────────────────
ADMIN_API_KEY=CHANGE_ME_LONG_RANDOM_VALUE

# ── CORS / Frontend ────────────────────────────────────────────
VITE_API_BASE_URL=/api/v2
CORS_ALLOW_ORIGINS=http://localhost:8000,http://localhost:5173

# ── Yerel çalıştırma ───────────────────────────────────────────
# ./run.sh Redis'i özel Unix soketiyle açar ve Celery bağlantılarını otomatik ayarlar.
# Docker/RabbitMQ kurulumu veya port 6379 açılması gerekmez.
# İsteğe bağlı ayrı veritabanı: AEGIS_DATABASE_URL=sqlite:////tam/yol/aegis.db
# İsteğe bağlı mevcut Chromium: AEGIS_CHROMIUM_PATH=/tam/yol/chromium

# ── AI Sağlayıcılar (opsiyonel — boşsa no-op) ──────────────────
GEMINI_API_KEY=
GROQ_API_KEY=

# ── Tehdit İstihbaratı (anahtarlı API'ler — boşsa no-op) ───────
VIRUSTOTAL_API_KEYS=
GOOGLE_SAFE_BROWSING_KEYS=
ALIENVAULT_OTX_API_KEY=
ABUSE_API_KEY=
ABUSEIPDB_API_KEYS=
URLHAUS_API_KEY=

# ── PhishTank (opsiyonel) ──────────────────────────────────────
PHISHTANK_APP_KEY=
PHISHTANK_USERNAME=aegisnexus

# ── Spamhaus (opsiyonel) ───────────────────────────────────────
SPAMHAUS_USERNAME=
SPAMHAUS_PASSWORD=

# Shared API / Celery coordination
RUNTIME_DB_PATH=./data/runtime.db
PDF_OUTPUT_DIR=./data/reports
CELERY_TIMEZONE=Europe/Istanbul
CELERY_IOC_INTERVAL_SECONDS=3600
CELERY_PHISHING_INTERVAL_SECONDS=3600
DEMO_MODE=0

# Account recovery (STARTTLS; credentials stay server-side)
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=


# ── Gelişmiş ayarlar (varsayılanlar app/config.py'de) ──────────
# Loglama: LOG_FORMAT=json yapılandırılmış log üretir.
# LOG_LEVEL=INFO
# LOG_FORMAT=text
# PDF_FONT_PATH=
# CRAWLER_DATA_DIR=./data/crawler

# Celery (./run.sh broker'ı kendisi ayarlar)
# CELERY_BROKER_URL=redis://127.0.0.1:6379/0
# CELERY_RESULT_BACKEND=
# CELERY_IOC_SOURCES=abuse_urlhaus,abuse_phishtank
# CELERY_IOC_LIMIT_PER_SOURCE=1000
# CELERY_WORKER_TYPE=
# CELERY_PRELOAD_MODELS=0

# Operatör uyarıları (phishing detector)
# SLACK_WEBHOOK_URL=
# ALERT_EMAIL_FROM=alerts@example.com
# ALERT_EMAIL_PASSWORD=
# ALERT_SMTP_SERVER=smtp.gmail.com
# ADMIN_EMAIL=admin@example.com

# AI modelleri ve bütçe
# GEMINI_MODEL=gemini-2.0-flash
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_MODEL=llama-3.3-70b-versatile
# AI_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# AI_SKIP_THRESHOLD=50
# AI_DAILY_LIMIT=14000

# Ek feed anahtarları ve limitleri
# PHISHTANK_API_KEYS=
# KAGGLE_USERNAME=
# KAGGLE_KEY=
# KAGGLE_API_TOKEN=
# PHISHING_GITHUB_FEEDS=
# PHISHING_OPENPHISH_LIMIT=20000
# PHISHING_URLHAUS_LIMIT=3000
# PHISHING_URLHAUS_PHISHING_ONLY=0
# PHISHING_KAGGLE_DATASET=taruntiwarihp/phishing-site-urls
# PHISHING_KAGGLE_LIMIT=100000
# PHISHING_OTX_LIMIT=200
# PHISHING_THREATFOX_LIMIT=500
# CERTSTREAM_WS_URL=wss://certstream.calidog.io/
# CERTSTREAM_MAX_URLS=500
# CERTSTREAM_DURATION_SECONDS=20
# CERTSTREAM_KEYWORDS=
# CERTSTREAM_ALLOW_GENERIC_DOMAINS=0

# Tarayıcı ayarları
# PHISHING_SCORING_MODEL=rule-based-v1
# THREAT_CACHE_MAX_ROWS=1000
# THREAT_SCAN_EVENTS_MAX_ROWS=5000
# SCAN_CACHE_TTL=21600
# PHISHING_JOB_TTL=3600
# THREAT_INTEL_WORKERS=5
# PLAYWRIGHT_POOL_SIZE=1
# SCREENSHOT_NETWORK_IDLE=1
# SCREENSHOT_NETWORK_IDLE_TIMEOUT_MS=12000
# PHASH_THRESHOLD=8
# EASYOCR_MODEL_DIR=./.easyocr_models

# Keşif crawler'ı (CertStream eşleştirici)
# AEGIS_CERTSTREAM_URL=wss://certstream.calidog.io
# AEGIS_CERTSTREAM_RATE=20
# AEGIS_CERTSTREAM_THRESHOLD=40
