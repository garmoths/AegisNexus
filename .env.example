# ── Uygulama ───────────────────────────────────────────────────
APP_NAME=Aegis Nexus

# Veritabanı: SQLite (kişisel proje — Postgres kaldırıldı)
# Host'ta ./data/aegis.db olarak saklanır (compose volume ile mapped).
DATABASE_URL=sqlite:///./data/aegis.db

# ── Bakımdaki Modüller (dış API bağımlılığı nedeniyle) ─────────
# 1 = breach_intel 503 döner (HIBP/Groq/Ollama bağımlılığı kaldırıldı)
BREACH_INTEL_MAINTENANCE=1

# ── Güvenlik ───────────────────────────────────────────────────
ADMIN_API_KEY=CHANGE_ME_LONG_RANDOM_VALUE

# ── CORS / Frontend ────────────────────────────────────────────
VITE_API_BASE_URL=/api/v2
CORS_ALLOW_ORIGINS=http://localhost:8000,http://localhost:5173

# ── Message Broker ─────────────────────────────────────────────
RABBITMQ_URL=amqp://aegis:CHANGE_ME@rabbitmq:5672/aegis
RABBITMQ_PASSWORD=CHANGE_ME

# ── AI Sağlayıcılar (opsiyonel — boşsa no-op) ──────────────────
GEMINI_API_KEY=CHANGE_ME
GROQ_API_KEY=CHANGE_ME
OPENAI_API_KEY=CHANGE_ME

# ── Tehdit İstihbaratı (anahtarlı API'ler — boşsa no-op) ───────
VIRUSTOTAL_API_KEYS=CHANGE_ME
GOOGLE_SAFE_BROWSING_KEYS=CHANGE_ME
ALIENVAULT_OTX_API_KEY=CHANGE_ME
ABUSE_API_KEY=CHANGE_ME
ABUSEIPDB_API_KEYS=CHANGE_ME
URLSCAN_API_KEYS=CHANGE_ME
URLHAUS_API_KEY=CHANGE_ME

# ── PhishTank (opsiyonel) ──────────────────────────────────────
PHISHTANK_APP_KEY=
PHISHTANK_USERNAME=aegisnexus

# ── HIBP (breach_intel modülü şu an bakımda) ───────────────────
HIBP_API_KEY=CHANGE_ME

# ── Spamhaus (opsiyonel) ───────────────────────────────────────
SPAMHAUS_USERNAME=CHANGE_ME
SPAMHAUS_PASSWORD=CHANGE_ME