# ── Uygulama ───────────────────────────────────────────────────
APP_NAME=Aegis Nexus

# Veritabanı: SQLite (kişisel proje — Postgres kaldırıldı)
# ./run.sh ile yerel data/aegis.db olarak saklanır.
DATABASE_URL=sqlite:///./data/aegis.db

# ── Güvenlik ───────────────────────────────────────────────────
ADMIN_API_KEY=CHANGE_ME_LONG_RANDOM_VALUE

# ── CORS / Frontend ────────────────────────────────────────────
VITE_API_BASE_URL=/api/v2
CORS_ALLOW_ORIGINS=http://localhost:8000,http://localhost:5173

# ── Yerel çalıştırma ───────────────────────────────────────────
# ./run.sh Redis'i özel Unix soketiyle açar ve Celery bağlantılarını otomatik ayarlar.
# Docker/RabbitMQ kurulumu veya port 6379 açılması gerekmez.
# İsteğe bağlı ayrı veritabanı: AEGIS_DATABASE_URL=sqlite:////tam/yol/aegis.db
# İsteğe bağlı mevcut Chromium: AEGIS_CHROMIUM_PATH=/tam/yol/chromium

# ── AI Sağlayıcılar (opsiyonel — boşsa no-op) ──────────────────
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

# ── Tehdit İstihbaratı (anahtarlı API'ler — boşsa no-op) ───────
VIRUSTOTAL_API_KEYS=
GOOGLE_SAFE_BROWSING_KEYS=
ALIENVAULT_OTX_API_KEY=
ABUSE_API_KEY=
ABUSEIPDB_API_KEYS=
URLSCAN_API_KEYS=
URLHAUS_API_KEY=

# ── PhishTank (opsiyonel) ──────────────────────────────────────
PHISHTANK_APP_KEY=
PHISHTANK_USERNAME=aegisnexus

# ── Spamhaus (opsiyonel) ───────────────────────────────────────
SPAMHAUS_USERNAME=
SPAMHAUS_PASSWORD=

# Shared API / Celery coordination
RUNTIME_DB_PATH=./data/runtime.db
PDF_OUTPUT_DIR=./data/reports
CELERY_TIMEZONE=Europe/Istanbul
CELERY_IOC_INTERVAL_SECONDS=3600
CELERY_PHISHING_INTERVAL_SECONDS=3600
VICTIM_ATLAS_INGEST_INTERVAL=21600
DEMO_MODE=0

# Account recovery (STARTTLS; credentials stay server-side)
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=

# Hosted iyzico checkout — disabled until keys, prices and public HTTPS URL are set.
PUBLIC_APP_URL=
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_SANDBOX=1
IYZICO_PRICE_PREMIUM=
IYZICO_PRICE_CORPORATE=
