# Uygulama
APP_NAME=Aegis Nexus

# Have I Been Pwned (e-posta sızıntı sorgusu — https://haveibeenpwned.com/API/Key)
HIBP_API_KEY=

# Threat Intelligence API Keys (opsiyonel — boş bırakılırsa o katman atlanır)

# VirusTotal - https://www.virustotal.com/gui/my-apikey
# Tekli key için: VIRUSTOTAL_API_KEY=your_key
# Rotation için (4 req/min limit aşıldığında): VIRUSTOTAL_API_KEYS=key1,key2,key3
VIRUSTOTAL_API_KEY=
VIRUSTOTAL_API_KEYS=

# urlscan.io - https://urlscan.io/user/api
# Tekli key için: URLSCAN_API_KEY=your_key
# Rotation için: URLSCAN_API_KEYS=key1,key2
URLSCAN_API_KEY=
URLSCAN_API_KEYS=

# Google Safe Browsing - https://console.cloud.google.com/apis/credentials
# Tekli key için: GOOGLE_SAFE_BROWSING_KEY=your_key
# Rotation için (10000 req/day limit): GOOGLE_SAFE_BROWSING_KEYS=key1,key2
GOOGLE_SAFE_BROWSING_KEY=
GOOGLE_SAFE_BROWSING_KEYS=

# AbuseIPDB - https://www.abuseipdb.com/account/api
# Tekli key için: ABUSEIPDB_API_KEY=your_key
# Rotation için (1500 req/day limit): ABUSEIPDB_API_KEYS=key1,key2
ABUSEIPDB_API_KEY=
ABUSEIPDB_API_KEYS=

# Veritabanı
DATABASE_URL=postgresql://enes@localhost/phishing_db
# İsteğe bağlı bağlantı havuzu (API yükü için)
# DB_POOL_SIZE=20
# DB_MAX_OVERFLOW=40

# Mevcut kurulum: scripts/migrate_add_url_hash.sql dosyasını PostgreSQL'de bir kez çalıştırın.
